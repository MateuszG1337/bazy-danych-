zadanie 1
1.
create table klient as select * from company_2025.CLIENT;
create table pracownik as select * from company_2025.EMPLOYEE;
create table pracownik as select * from company_2025.EMPLOYEE;
2.
select * from zamowienie
3.
select * from zamowienie where ORDER_STATUS=5
4.
select ORDER_ID,ORDER_STATUS from zamowienie where CLIENT_ID  IN (1,3,5);
zadanie 2
1.
select * from pracownik where FIRST_NAME = 'agnieszka' and pensja=3900;
2.
select * from pracownik where pensja between 5000 and 7000;
3.
select * from klient where SHORT_NAME like '%eco%'  and IS_COMPANY=1;
zadanie 3
1.
select * from zamowienie where month(ORDER_DATE) IN (6,7) 
2.
SELECT * FROM klient where TAX_IDENTIFIER is not null order by SHORT_NAME asc
3.
SELECT * FROM pracownik order by birth_date asc limit 5;
zadanie 4
1.
select distinct first_name from pracownik ;
2.
select first_name,last_name  from pracownik where last_name like 'ko%' 
3.
select last_name, pensja from pracownik where extract(year from date_of_employment) between 2010 and 2014;
zadanie 5
1.
select 
	pensja as pensja_brutto,
    pensja * 0.75 as pensja_netto,
    pensja * 0.25 as kwota_podatku
from pracownik;
2.
select * from klient
where TAX_IDENTIFIER is null;
3.
select short_name from klient where SHORT_NAME like 'k%' or SHORT_NAME like '%ski'
order by short_name desc;
